<%= turbo_frame_tag "coupons_data_widget" do %>
  <% @coupons.each do |coupon| %>
    <div class="rew">
      <div class="rew-icon">☕</div>
      <div class="rew-info"><div class="rew-name">Free Coffee</div>
      <div class="rew-desc">
        <% if coupon.used_at %>
          Used at <%= friendly_time(coupon.used_at) %>! This coupon was created at <%= friendly_time(coupon.created_at) %>
        <% else %>
          Not used yet! This coupon was created at <%= friendly_time(coupon.created_at) %>.
        <% end %>
        <div class="coupon-user"><%= coupon.user.full_name %></div>
      </div>
      </div>
      <% if coupon.used_at %>
        <span class="rew-badge lock">
          Used
        </span>
      <% else %>
        <span class="rew-badge ready">
          Ready
        </span>
      <% end %>
    </div>
  <% end %>
  
  <div class="pager">
    <% if @pagy.prev %>
      <%= link_to customers_dashboard_coupons_path(page: @pagy.prev),
          class: "pg-btn",
          data: { turbo_frame: "coupons_data_widget" } do %>
        ‹ Prev
      <% end %>
    <% else %>
      <span class="pg-btn disabled">‹ Prev</span>
    <% end %>

    <span class="pg-info">
      Page <strong><%= @pagy.page %></strong> of <strong><%= @pagy.last %></strong>
    </span>

    <% if @pagy.next %>
      <%= link_to customers_dashboard_coupons_path(page: @pagy.next),
          class: "pg-btn",
          data: { turbo_frame: "coupons_data_widget" } do %>
        Next ›
      <% end %>
    <% else %>
      <span class="pg-btn disabled">Next ›</span>
    <% end %>
  </div>
<% end %>