
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=DM+Serif+Display&display=swap" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box;}
html,body{width:100%;min-height:100vh;background:#F5F0E8;color:#2D1B06;font-family:'DM Sans',system-ui,sans-serif;-webkit-font-smoothing:antialiased;}

/* ── MAIN ── */
.content{flex:1;margin-left:240px;min-height:100vh;}

/* Top bar */
.topbar{
  height:64px;background:rgba(245,240,232,0.8);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);
  border-bottom:1px solid #EBE3D7;display:flex;align-items:center;justify-content:space-between;
  padding:0 32px;position:sticky;top:0;z-index:50;
}
.topbar h1{font-family:'DM Serif Display',serif;font-size:22px;color:#2D1B06;}
.topbar-r{display:flex;align-items:center;gap:12px;}
.tb-btn{
  width:36px;height:36px;border-radius:10px;background:#FFFCF8;border:1px solid #F0E9DE;
  display:flex;align-items:center;justify-content:center;font-size:16px;cursor:pointer;
  transition:all .15s;position:relative;
}
.tb-btn:hover{background:#fff;border-color:#D4C4AC;}
.tb-dot{position:absolute;top:6px;right:6px;width:7px;height:7px;border-radius:50%;background:#DC2626;border:2px solid #F5F0E8;}

/* ── DASHBOARD BODY ── */
.dash{padding:28px 32px 48px;}

/* Welcome */
.welcome{margin-bottom:28px;}
.welcome h2{font-family:'DM Serif Display',serif;font-size:28px;color:#2D1B06;margin-bottom:4px;}
.welcome p{font-size:14px;color:#8C7A65;}

/* Stat cards */
.stats-row{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-bottom:28px;}
.stat-card{
  background:#FFFCF8;border:1px solid #F0E9DE;border-radius:16px;padding:22px 20px;
  transition:all .25s;
}
.stat-card:hover{border-color:#D4C4AC;box-shadow:0 4px 20px rgba(45,27,6,0.04);transform:translateY(-2px);}
.sc-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;}
.sc-label{font-size:12px;font-weight:600;color:#B8A898;text-transform:uppercase;letter-spacing:1px;}
.sc-icon{width:32px;height:32px;border-radius:9px;display:flex;align-items:center;justify-content:center;font-size:16px;}
.sc-icon.c1{background:#FEF3C7;}
.sc-icon.c2{background:#DBEAFE;}
.sc-icon.c3{background:#D1FAE5;}
.sc-icon.c4{background:#FCE7F3;}
.sc-num{font-family:'DM Serif Display',serif;font-size:32px;color:#2D1B06;margin-bottom:4px;}
.sc-sub{font-size:12px;color:#8C7A65;}
.sc-sub span{font-weight:700;}
.sc-sub .up{color:#16A34A;}
.sc-sub .dn{color:#DC2626;}

/* Two column */
.two-col{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:28px;}

/* Card container */
.card{background:#FFFCF8;border:1px solid #F0E9DE;border-radius:16px;overflow:hidden;}
.card-h{display:flex;align-items:center;justify-content:space-between;padding:18px 20px;border-bottom:1px solid #F5EFE6;}
.card-h h3{font-size:15px;font-weight:700;color:#2D1B06;}
.card-h a{font-size:12px;color:#A16207;text-decoration:none;font-weight:600;}
.card-h a:hover{text-decoration:underline;}

/* Loyalty card */
.loyalty{padding:24px 20px;text-align:center;}
.loyalty .lbl{font-size:11px;color:#B8A898;text-transform:uppercase;letter-spacing:1.5px;margin-bottom:6px;}
.loyalty .pts{font-family:'DM Serif Display',serif;font-size:48px;color:#A16207;}
.loyalty .nxt{font-size:13px;color:#8C7A65;margin-top:6px;margin-bottom:20px;}
.stamps{display:grid;grid-template-columns:repeat(5,1fr);gap:8px;max-width:280px;margin:0 auto;}
.stmp{
  aspect-ratio:1;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:16px;
}
.stmp.on{background:#FEF3C7;border:1.5px solid #F3D675;}
.stmp.off{background:#F8F4ED;border:1.5px dashed #E0D5C7;}
.stmp.gift{background:linear-gradient(135deg,#A16207,#D4A017);border:none;box-shadow:0 3px 12px rgba(161,98,7,0.25);}
.loyalty .prog{margin-top:16px;}
.prog-bar{height:6px;background:#F0E9DE;border-radius:99px;overflow:hidden;margin-bottom:6px;}
.prog-fill{height:100%;background:linear-gradient(90deg,#A16207,#D4A017);border-radius:99px;transition:width .6s ease;}
.prog-text{display:flex;justify-content:space-between;font-size:11px;color:#B8A898;}

/* Recent activity */
.activity-list{padding:0;}
.act-item{
  display:flex;align-items:center;gap:14px;padding:14px 20px;
  border-bottom:1px solid #F8F4ED;transition:background .15s;
}
.act-item:last-child{border-bottom:none;}
.act-item:hover{background:#FDFAF5;}
.act-icon{width:38px;height:38px;border-radius:11px;background:#F8F1E7;display:flex;align-items:center;justify-content:center;font-size:18px;flex-shrink:0;}
.act-info{flex:1;min-width:0;}
.act-name{font-size:13px;font-weight:600;color:#2D1B06;}
.act-date{font-size:11px;color:#B8A898;margin-top:1px;}
.act-pts{font-size:14px;font-weight:700;color:#16A34A;white-space:nowrap;}
.act-pts.used{color:#A16207;}

/* Rewards */
.rewards-list{padding:12px 20px 20px;display:flex;flex-direction:column;gap:10px;}
.rew{
  display:flex;align-items:center;gap:14px;padding:14px 16px;
  border-radius:12px;border:1px solid #F0E9DE;background:#FDFAF5;
  transition:all .2s;
}
.rew:hover{border-color:#D4C4AC;box-shadow:0 2px 10px rgba(45,27,6,0.04);}
.rew-icon{width:40px;height:40px;border-radius:10px;background:#FEF3C7;display:flex;align-items:center;justify-content:center;font-size:20px;flex-shrink:0;}
.rew-info{flex:1;min-width:0;}
.rew-name{font-size:13px;font-weight:700;color:#2D1B06;}
.rew-desc{font-size:11px;color:#B8A898;margin-top:1px;}
.rew-badge{
  padding:5px 12px;border-radius:8px;font-size:11px;font-weight:700;white-space:nowrap;
}
.rew-badge.ready{background:#D1FAE5;color:#166534;}
.rew-badge.lock{background:#F3ECE2;color:#8C7A65;}

/* Quick actions */
.actions-row{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;}
.qa{
  background:#FFFCF8;border:1px solid #F0E9DE;border-radius:14px;
  padding:20px;text-align:center;cursor:pointer;transition:all .2s;
}
.qa:hover{border-color:#D4C4AC;box-shadow:0 4px 16px rgba(45,27,6,0.04);transform:translateY(-2px);}
.qa-icon{font-size:28px;margin-bottom:10px;}
.qa-title{font-size:13px;font-weight:700;color:#2D1B06;margin-bottom:3px;}
.qa-desc{font-size:11px;color:#B8A898;}

/* ── MOBILE ── */
.burger{display:none;width:36px;height:36px;border-radius:10px;background:#FFFCF8;border:1px solid #F0E9DE;align-items:center;justify-content:center;font-size:18px;cursor:pointer;}
.overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,0.3);z-index:99;}

@media(max-width:900px){
  .side{transform:translateX(-100%);}
  .side.open{transform:translateX(0);}
  .overlay.open{display:block;}
  .content{margin-left:0;}
  .burger{display:flex;}
  .stats-row{grid-template-columns:repeat(2,1fr);}
  .two-col{grid-template-columns:1fr;}
  .actions-row{grid-template-columns:1fr;}
  .topbar{padding:0 20px;}
  .dash{padding:20px 20px 40px;}
}
@media(max-width:480px){
  .stats-row{grid-template-columns:1fr;}
}



/* Scanner container */
.scanner-wrap{
  display:none;
  background:#FFFCF8;border:1px solid #F0E9DE;border-radius:16px;
  overflow:hidden;margin-bottom:24px;
  box-shadow:0 4px 20px rgba(45,27,6,0.06);
}
.scanner-wrap.open{display:block;animation:slideDown .3s ease;}
@keyframes slideDown{from{opacity:0;max-height:0}to{opacity:1;max-height:400px}}

.scanner-header{
  display:flex;align-items:center;justify-content:space-between;
  padding:12px 16px;border-bottom:1px solid #F0E9DE;
}
.scanner-header span{font-size:13px;font-weight:600;color:#2D1B06;display:flex;align-items:center;gap:6px;}
.scanner-close{
  width:28px;height:28px;border-radius:8px;border:none;
  background:#F3ECE2;cursor:pointer;font-size:14px;
  display:flex;align-items:center;justify-content:center;
  color:#8C7A65;transition:all .15s;
}
.scanner-close:hover{background:#EAE0D2;color:#2D1B06;}

.scanner-viewport{
  width:100%;aspect-ratio:1;position:relative;background:#0a0a0a;
}
.scanner-viewport #reader{width:100%!important;height:100%!important;}
.scanner-viewport #reader video{border-radius:0!important;}

.scanner-hint{
  padding:10px 16px;text-align:center;
  font-size:11px;color:#8C7A65;background:#FDFAF5;
}


.pager{
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding:14px 18px;
  border-top:1px solid #F8F4ED;
}

.pg-btn{
  display:inline-flex;
  align-items:center;
  padding:7px 14px;
  border-radius:8px;
  font-size:12px;
  font-weight:600;
  text-decoration:none;
  color:#5C4A35;
  background:#FFFCF8;
  border:1px solid #F0E9DE;
  transition:all .15s;
}
.pg-btn:hover{
  background:#F8F1E7;
  border-color:#D4C4AC;
}
.pg-btn.disabled{
  color:#D5C9BA;
  cursor:default;
  border-color:#F0E9DE;
  background:transparent;
}
.pg-btn.disabled:hover{
  background:transparent;
}

.pg-info{
  font-size:12px;
  color:#8C7A65;
}
.pg-info strong{
  color:#2D1B06;
}

/* Spinner */
.spinner{
  width:27px;height:27px;border-radius:50%;
  border:3px solid #E8DFD2;
  border-top-color:#A16207;
  animation:spin .8s linear infinite;
  margin:0 auto 20px;
}
@keyframes spin{to{transform:rotate(360deg)}}

.loader{text-align:center;padding:40px 20px;}
.loader-text{font-size:13px;font-weight:600;color:#8C7A65;}
.loader-dots::after{content:'';animation:dots 1.5s steps(3) infinite;}
@keyframes dots{0%{content:''}33%{content:'.'}66%{content:'..'}100%{content:'...'}}

/* Small inline spinner (for buttons, widgets) */
.spinner-sm{
  width:20px;height:20px;border-radius:50%;
  border:2.5px solid #E8DFD2;
  border-top-color:#A16207;
  animation:spin .8s linear infinite;
  display:inline-block;
}

/* Full page overlay */
.loading-overlay{
  position:fixed;inset:0;z-index:9999;
  background:rgba(245,240,232,0.85);
  backdrop-filter:blur(4px);-webkit-backdrop-filter:blur(4px);
  display:flex;align-items:center;justify-content:center;
  flex-direction:column;gap:4px;
}
.loading-overlay .spinner{
  width:48px;height:48px;
  border-width:3px;
}
.loading-overlay .loader-text{
  font-size:13px;font-weight:600;color:#8C7A65;
}
</style>

<!-- MAIN -->
<div class="content">

  <!-- TOP BAR -->
  <header class="topbar">
    <div style="display:flex;align-items:center;gap:12px;">
      <div class="burger" id="burger">☰</div>
      <h1>Dashboard</h1>
    </div>
  </header>

  <!-- DASHBOARD -->
  <div class="dash">

    <!-- Welcome -->
    <div class="welcome">
      <h2>Good morning, <%= current_customer.name %></h2>
    </div>

    <!-- Stats -->
    <div class="stats-row">
      <div class="stat-card">
        <div class="sc-top"><span class="sc-label">Stamps</span><div class="sc-icon c3">💳</div></div>
        <%= turbo_frame_tag "stamps_widget", src: customers_dashboard_count_stamps_path do %>
          <div class="loader">
            <div class="spinner"></div>
            <div class="loader-text">Loading<span class="loader-dots"></span></div>
          </div>
        <% end %>
      </div>
      <div class="stat-card">
        <div class="sc-top"><span class="sc-label">Users</span><div class="sc-icon c2">🧑‍🦱</div></div>
          <%= turbo_frame_tag "users_widget", src: customers_dashboard_count_users_path do %>
            <div class="loader">
              <div class="spinner"></div>
              <div class="loader-text">Loading<span class="loader-dots"></span></div>
            </div>
          <% end %>
      </div>
      <div class="stat-card">
        <div class="sc-top"><span class="sc-label">Coupons</span><div class="sc-icon c3">🎟</div></div>
        <%= turbo_frame_tag "coupons_widget", src: customers_dashboard_count_coupons_path do %>
          <div class="loader">
            <div class="spinner"></div>
            <div class="loader-text">Loading<span class="loader-dots"></span></div>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Two column -->
    <div class="two-col">

      <!-- Loyalty Card -->
      <div class="card">
        <% if @card %>
          <div class="card-h"><h3>My Loyalty Card</h3>
            <%= link_to "View Card",
            customers_card_path(@card),
            title: "View" %>
          </div>
          <div class="loyalty">
            <div class="lbl">Total Points</div>
            <div class="pts"><%= Rails.cache.read("dashboard_points_total") %></div>
            <div class="stamps">
              <% @card.reward_rule.times do%>
                <div class="stmp on">☕</div>
              <% end %>
              <% @card.how_many.times do%>
                <div class="stmp gift">🎁</div>
              <% end %>
            </div>
          </div>
        <% else %>
          <div class="card-h"><h3>My Loyalty Card</h3>
          </div>
          <div class="loyalty">
            Your loyalty card will be here!
          </div>
        <% end %>
      </div>

      <!-- Recent Activity -->
      <div class="card">
        <div class="card-h"><h3>Recent Activity</h3><a href="#">View all</a></div>
        <div class="activity-list">
          <%= turbo_frame_tag "activity_widget", src: customers_dashboard_activity_path do %>
            <div class="loader">
              <div class="spinner"></div>
              <div class="loader-text">Loading<span class="loader-dots"></span></div>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Rewards -->
    <div class="card" style="margin-bottom:28px;">
      <div class="card-h"><h3>Coupons Redeemed</h3><a href="#">Browse all</a></div>
      <div class="rewards-list">
        <%= turbo_frame_tag "coupons_data_widget", src: customers_dashboard_coupons_path do %>
          <div class="loader">
            <div class="spinner"></div>
            <div class="loader-text">Loading<span class="loader-dots"></span></div>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Quick Actions -->
    <div class="actions-row">
      <button id="scanBtn" onclick="toggleScanner()">
        <div class="qa">
          <div class="qa-icon">📷</div>
          <div class="qa-title">Scan QR Code</div>
          <div class="qa-desc">Redeem Client`s Coupons</div>
        </div>
      </button>

      <div class="scanner-wrap" id="scannerWrap">
        <div class="scanner-header">
          <span>📷 Camera</span>
          <button class="scanner-close" onclick="closeScanner()">✕</button>
        </div>
        <div class="scanner-viewport">
          <div id="reader"></div>
        </div>
        <div class="scanner-hint">Point your camera at the QR code on the counter</div>
      </div>

      <button id="" onclick="">
        <div class="qa">
          <div class="qa-icon">📍</div>
          <div class="qa-title">Find a Shop</div>
          <div class="qa-desc">Nearby PerkUp locations</div>
        </div>
      </button>
      
      <button id="" onclick="">
        <div class="qa">
          <div class="qa-icon">👥</div>
          <div class="qa-title">Refer a Friend</div>
          <div class="qa-desc">Both earn 50 bonus points</div>
        </div>
      </button>
    </div>
  </div>
</div>

<script>
var burger=document.getElementById('burger');
var sidebar=document.getElementById('sidebar');
var overlay=document.getElementById('overlay');
burger.addEventListener('click',function(){sidebar.classList.toggle('open');overlay.classList.toggle('open');});
overlay.addEventListener('click',function(){sidebar.classList.remove('open');overlay.classList.remove('open');});

// Nav active state
document.querySelectorAll('.sn-item').forEach(function(item){
  item.addEventListener('click',function(){
    document.querySelectorAll('.sn-item').forEach(function(i){i.classList.remove('active');});
    this.classList.add('active');
    if(window.innerWidth<=900){sidebar.classList.remove('open');overlay.classList.remove('open');}
  });
});
</script>



<script src="https://unpkg.com/html5-qrcode"></script>
<script>
  var html5QrCode;
  var scanning = false;

  function toggleScanner() {
    if (scanning) {
      closeScanner();
    } else {
      openScanner();
    }
  }

  function openScanner() {
    var wrap = document.getElementById("scannerWrap");
    var btn  = document.getElementById("scanBtn");
    wrap.classList.add("open");
    scanning = true;

    btn.innerHTML =
        '<div class="qa">' +
        '<div class="qa-icon">📷</div>' +
        '<div class="qa-title">Scanning...</div>' +
        '<div class="qa-desc">Redeem Client`s Coupons</div>'+
      '</div>';

    html5QrCode = new Html5Qrcode("reader");

    html5QrCode.start(
      { facingMode: "environment" },
      { fps: 10, qrbox: { width: 250, height: 250 } },
      function(decodedText) {
        scanning = false;
        html5QrCode.stop().then(function() {
          btn.innerHTML =
            '<div class="qa">' +
        '<div class="qa-icon">📷</div>' +
        '<div class="qa-title">Scanning...</div>' +
        '<div class="qa-desc">Redeem Client`s Coupons</div>' + 
      '</div>';

          btn.style.background = "#166534";
          window.location.href = decodedText;
        }).catch(function() {
          window.location.href = decodedText;
        });
      },
      function(errorMessage) {}
    ).catch(function(err) {
      // Camera permission denied or not available
      scanning = false;
      wrap.classList.remove("open");
      resetButton();
      alert("Camera access denied. Please allow camera permission in your browser settings and try again.");
    });
  }

  function closeScanner() {
    var wrap = document.getElementById("scannerWrap");
    wrap.classList.remove("open");
    resetButton();

    if (html5QrCode && scanning) {
      scanning = false;
      html5QrCode.stop().catch(function() {});
    } else {
      scanning = false;
    }
  }

  function resetButton() {
    var btn = document.getElementById("scanBtn");
    btn.innerHTML =
      '<div class="qa">' +
        '<div class="qa-icon">📷</div>' +
        '<div class="qa-title">Scan QR Code</div>' +
        '<div class="qa-desc">Redeem Client`s Coupons</div>' +
      '</div>';

    btn.style.background = "";
  }
</script>

