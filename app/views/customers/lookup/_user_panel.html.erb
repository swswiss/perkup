<div class="up-header">
  <div class="up-info">
    <div class="up-name"><%= @user.full_name %></div>
    <div class="up-email"><%= @user.email %></div>
    <div class="up-badges">
      <span class="up-badge member">● Active</span>
    </div>
  </div>
  <button class="up-close" data-action="customer-search#closeUser">✕</button>
</div>

<div class="stats-row">
  <div class="stat">
    <div class="stat-icon">☕</div>
    <div class="stat-num"><%= @stats[:stamps] %></div>
    <div class="stat-label">Stampile totale</div>
  </div>
  <div class="stat">
    <div class="stat-icon">⭐</div>
    <div class="stat-num"><%= @stats[:points] %></div>
    <div class="stat-label">Puncte</div>
  </div>
  <div class="stat">
    <div class="stat-icon">🎟</div>
    <div class="stat-num"><%= @stats[:coupons] %></div>
    <div class="stat-label">Cupoane</div>
  </div>
  <div class="stat">
    <div class="stat-icon">📅</div>
    <div class="stat-num"><%= @stats[:since] %></div>
    <div class="stat-label">Membru de la</div>
  </div>
</div>

<div class="tabs">
  <button class="tab active" data-action="customer-search#switchTab" data-tab="stamps">Stampile</button>
  <button class="tab" data-action="customer-search#switchTab" data-tab="coupons">Cupoane</button>
</div>


<div class="tab-content show" id="tab-stamps">
  <%= turbo_frame_tag "lookup-stamps" do %>
    <%= render "stamps_list" %>
  <% end %>
</div>

<div class="tab-content" id="tab-coupons">
  <%= turbo_frame_tag "lookup-coupons" do %>
    <%= render "coupons_list" %>
  <% end %>
</div>

