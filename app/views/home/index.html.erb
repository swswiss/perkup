<script>
var io=new IntersectionObserver(function(e){e.forEach(function(x){if(x.isIntersecting){x.target.classList.add('v');io.unobserve(x.target);}});},{threshold:.12,rootMargin:'0px 0px -30px 0px'});
document.querySelectorAll('.a').forEach(function(el){io.observe(el);});
</script>
