<!-- SIDEBAR -->

<div class="overlay" id="overlay"></div>
<aside class="side" id="sidebar">
  <div class="side-head">
    <span class="lm">☕</span>
    <span class="lt">PerkUp</span>
  </div>
  <nav class="side-nav">
    <%= link_to 'Dashboard',
    customers_dashboard_path,
    class: "sn-item #{nav_active(customers_dashboard_path)}" %>

    <%= link_to "My Cards",
      customers_cards_path,
      class: "sn-item #{nav_active(customers_cards_path)}" %>

    <%= link_to "Create new Card",
      new_customers_card_path,
      class: "sn-item #{nav_active(new_customers_card_path)}" %>
    <a class="sn-item">All users</a>
    <div class="sn-sep"></div>
    <a class="sn-item">Settings</a>
    <a class="sn-item">Help</a>
    <%= link_to 'Logout', destroy_customer_session_path, method: :delete, class: "sn-item" %>
  </nav>
  <div class="side-foot">
    <div class="side-user">
      <div class="u-info">
        <div class="u-name"><%= current_customer.name %></div>
        <div class="u-email"><%= current_customer.email %></div>
      </div>
    </div>
  </div>
</aside>