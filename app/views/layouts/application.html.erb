<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Perkup" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <meta name="theme-color" content="#000000">
    <link rel="apple-touch-icon" href="/coffee.png">

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/coffee.png" type="image/png">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <script>
    if ("serviceWorker" in navigator) {
      navigator.serviceWorker.register("/service-worker.js");
    }
  </script>
  <body data-turbo-prefetch="false">
    <%= render "customers/shared/flash" %>
    <% if customer_signed_in? && params[:action] == 'live_qrcode' %>
      <main class="container mx-auto mt-28 px-5 flex">  
        <%= yield %>
      </main>
    <% elsif user_signed_in? && (params[:action] == 'check' || params[:action] == 'success' || params[:action] == 'reward' || params[:action] == 'expired') %>
      <main class="container mx-auto mt-28 px-5 flex">  
        <%= yield %>
      </main>
    <% elsif customer_signed_in? %>
      <%= render "layouts/sidenav_customer"%>
      <main class="container mx-auto mt-28 px-5 flex">  
        <%= yield %>
      </main>
    <%elsif user_signed_in?%>
      <%= render "layouts/sidenav_user"%>
      <main class="container mx-auto mt-28 px-5 flex">  
        <%= yield %>
      </main>
      <%= render "layouts/sidenav_bottom_user"%>
    <%else%>
      <main class="container mx-auto mt-28 px-5 flex">  
        <%= yield %>
      </main>
    <%end%>
  </body>
</html>
