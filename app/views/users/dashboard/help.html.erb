<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=DM+Serif+Display&display=swap" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box;}
html,body{width:100%;min-height:100vh;background:#F5F0E8;color:#2D1B06;font-family:'DM Sans',system-ui,sans-serif;-webkit-font-smoothing:antialiased;}
body{display:flex;flex-direction:column;}

/* ── TOP NAV ── */
.topnav{
  height:56px;background:#FFFCF8;border-bottom:1px solid #F0E9DE;
  display:flex;align-items:center;justify-content:space-between;
  padding:0 20px;position:sticky;top:0;z-index:100;
}
.topnav-l{display:flex;align-items:center;gap:10px;}
.logo-m{width:28px;height:28px;border-radius:8px;background:#2D1B06;display:flex;align-items:center;justify-content:center;font-size:14px;color:#fff;}
.logo-t{font-weight:800;font-size:16px;color:#2D1B06;}
.topnav-r{display:flex;align-items:center;gap:12px;}
.nav-link{font-size:13px;font-weight:500;color:#8C7A65;text-decoration:none;padding:6px 12px;border-radius:8px;transition:all .15s;}
.nav-link:hover{color:#2D1B06;background:#F8F1E7;}
.nav-link.active{color:#2D1B06;font-weight:700;background:#F3ECE2;}
.nav-links-desktop{display:flex;align-items:center;gap:4px;}
.user-pill{
  display:flex;align-items:center;gap:8px;padding:4px 12px 4px 4px;
  border-radius:99px;background:#F3ECE2;cursor:pointer;transition:background .15s;
}
.user-pill:hover{background:#EAE0D2;}
.user-pill .av{width:28px;height:28px;border-radius:50%;background:linear-gradient(135deg,#A16207,#D4A017);display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;color:#fff;}
.user-pill .un{font-size:12px;font-weight:600;color:#2D1B06;}

/* ── MOBILE NAV ── */
.mob-nav{
  display:none;position:fixed;bottom:0;left:0;right:0;z-index:100;
  background:#FFFCF8;border-top:1px solid #F0E9DE;
  padding:6px 0 calc(6px + env(safe-area-inset-bottom));
}
.mob-nav-inner{display:flex;justify-content:space-around;}
.mn-item{
  display:flex;flex-direction:column;align-items:center;gap:2px;
  padding:6px 12px;font-size:10px;font-weight:600;color:#B8A898;
  text-decoration:none;transition:color .15s;
}
.mn-item {font-size:15px;}
.mn-item.active{color:#A16207;}

@media(max-width:600px){
  .nav-links-desktop{display:none;}
  .mob-nav{display:block;}
  .main{padding-bottom:100px;}
  .welcome h1{font-size:22px;}
}

/* ── Loyalty card upgrade ── */
.my-card{
  max-width:370px;
  margin:0 auto 24px;
  padding:0;
  border-radius:24px;
  overflow:hidden;
}

/* Gold accent line at top */
.my-card::after{
  content:'';position:absolute;
  top:0;left:0;right:0;height:3px;
  background:linear-gradient(90deg,transparent,#D4A017,transparent);
  font-size:0;opacity:1;
}

/* Top section */
.mc-top{
  padding:32px 28px 24px;
  position:relative;z-index:1;
}
.mc-header{
  display:flex;align-items:center;justify-content:space-between;
  margin-bottom:24px;
}
.mc-brand{display:flex;align-items:center;gap:10px;}
.mc-logo{
  width:36px;height:36px;border-radius:10px;
  background:linear-gradient(135deg,#A16207,#D4A017);
  display:flex;align-items:center;justify-content:center;
  font-size:18px;
  box-shadow:0 3px 10px rgba(161,98,7,0.3);
}
.mc-shop{
  font-size:13px;font-weight:700;letter-spacing:.3px;
  text-transform:none;opacity:1;margin:0;
}
.mc-type{
  font-size:9px;text-transform:uppercase;letter-spacing:2px;
  opacity:.3;font-weight:600;
}
.mc-name{
  font-size:28px;margin:0 0 6px;
}
.mc-since{
  font-size:11px;opacity:.25;
  display:flex;align-items:center;gap:6px;
}
.mc-since-dot{
  width:4px;height:4px;border-radius:50%;
  background:rgba(212,160,23,0.5);
}

/* Tear divider */
.mc-divider{
  position:relative;
  height:1px;
  margin:0;
}
.mc-divider::before{
  content:'';position:absolute;
  top:0;left:28px;right:28px;
  border-top:1.5px dashed rgba(255,255,255,0.06);
}
.mc-notch{
  width:22px;height:22px;border-radius:50%;
  background:#F5F0E8;
  position:absolute;top:50%;transform:translateY(-50%);
  z-index:2;
}
.mc-notch-l{left:-11px;}
.mc-notch-r{right:-11px;}

/* QR section */
.mc-qr{
  padding:24px 28px 32px;
  text-align:center;
  position:relative;z-index:1;
}
.mc-qr-label{
  font-size:9px;text-transform:uppercase;letter-spacing:2.5px;
  opacity:.2;font-weight:600;margin-bottom:18px;
}
.mc-qr-frame{
  display:inline-block;
  padding:14px;
  background:#FFFCF8;
  border-radius:18px;
  box-shadow:0 4px 16px rgba(0,0,0,0.08);
  margin-bottom:16px;
}
.mc-qr-frame img{
  display:block;
  border-radius:6px;
}
.mc-qr-hint{
  font-size:11px;opacity:.2;
}


.topnav{height:56px;background:#FFFCF8;border-bottom:1px solid #F0E9DE;display:flex;align-items:center;justify-content:space-between;padding:0 20px;position:sticky;top:0;z-index:100;}
.topnav-l{display:flex;align-items:center;gap:10px;}
.logo-m{width:28px;height:28px;border-radius:8px;background:#2D1B06;display:flex;align-items:center;justify-content:center;font-size:14px;color:#fff;}
.logo-t{font-weight:800;font-size:16px;color:#2D1B06;}
.back-link{font-size:13px;color:#8C7A65;text-decoration:none;font-weight:600;display:flex;align-items:center;gap:4px;}
.back-link:hover{color:#2D1B06;}

.tut{max-width:420px;margin:0 auto;padding:20px;}
.tut-head{text-align:center;margin-bottom:32px;}
.tut-logo{font-size:32px;margin-bottom:10px;}
.tut-title{font-family:'DM Serif Display',serif;font-size:24px;color:#2D1B06;margin-bottom:4px;}
.tut-sub{font-size:13px;color:#8C7A65;}

.tut-steps{display:flex;flex-direction:column;gap:0;}

.ts{display:flex;gap:14px;position:relative;}
.ts-line{display:flex;flex-direction:column;align-items:center;flex-shrink:0;width:36px;}
.ts-num{
  width:36px;height:36px;border-radius:10px;
  background:#2D1B06;color:#FFFCF8;
  display:flex;align-items:center;justify-content:center;
  font-family:'DM Serif Display',serif;font-size:16px;
  flex-shrink:0;box-shadow:0 3px 8px rgba(45,27,6,0.1);
}
.ts-wire{flex:1;width:2px;background:#E8DFD2;margin:6px 0;}
.ts:last-child .ts-wire{display:none;}

.ts-body{flex:1;padding-bottom:24px;}
.ts:last-child .ts-body{padding-bottom:0;}
.ts-title{font-size:15px;font-weight:700;color:#2D1B06;margin-bottom:4px;padding-top:6px;}
.ts-desc{font-size:12px;color:#8C7A65;line-height:1.6;margin-bottom:12px;}
.ts-desc .hl{background:#FEF3C7;padding:1px 6px;border-radius:4px;font-weight:700;color:#92400E;}

/* Screenshot */
.ts-img-wrap{
  border-radius:14px;overflow:hidden;
  border:2px solid #F0E9DE;
  box-shadow:0 4px 16px rgba(45,27,6,0.06);
  position:relative;
}
.ts-img-wrap img{
  width:100%;display:block;
}

/* Red circle annotation overlay */
.ts-img-wrap .annotation{
  position:absolute;
  border:3px solid #DC2626;
  border-radius:50%;
  pointer-events:none;
  box-shadow:0 0 0 4px rgba(220,38,38,0.15);
  animation:pulse-ring 2s ease infinite;
}
@keyframes pulse-ring{
  0%,100%{box-shadow:0 0 0 4px rgba(220,38,38,0.15);}
  50%{box-shadow:0 0 0 8px rgba(220,38,38,0.08);}
}

/* Arrow from annotation */
.ts-img-wrap .arrow-label{
  position:absolute;
  background:#DC2626;color:#fff;
  font-size:10px;font-weight:700;
  padding:3px 10px;border-radius:6px;
  white-space:nowrap;
  box-shadow:0 2px 8px rgba(220,38,38,0.2);
}

/* Done banner */
.tut-done{
  text-align:center;margin-top:28px;
  background:#D1FAE5;border-radius:14px;padding:18px;
}
.tut-done-icon{font-size:28px;margin-bottom:6px;}
.tut-done-text{font-size:14px;font-weight:700;color:#166534;}
.tut-done-sub{font-size:11px;color:#15803D;margin-top:2px;}

/* ── Override: horizontal steps ── */
.tut{max-width:960px;margin:0 auto;padding:20px;}

.tut-steps{
  display:flex;
  flex-direction:row;
  gap:16px;
  align-items:flex-start;
}

.ts{
  flex:1;
  display:flex;
  flex-direction:column;
  align-items:center;
  text-align:center;
  position:relative;
}

/* Horizontal connector arrow between steps */
.ts:not(:last-child)::after{
  content:'→';
  position:absolute;
  top:16px;
  right:-14px;
  font-size:18px;
  color:#D5C9BA;
  font-weight:700;
}

/* Hide vertical line elements */
.ts-line{
  display:flex;
  flex-direction:column;
  align-items:center;
  width:auto;
  margin-bottom:12px;
}
.ts-wire{display:none;}

.ts-body{
  padding-bottom:0;
  width:100%;
}

.ts-title{padding-top:0;}

/* Responsive: stack on mobile */
@media(max-width:700px){
  .tut-steps{
    flex-direction:column;
    gap:0;
  }
  .ts{align-items:flex-start;text-align:left;flex-direction:row;gap:14px;}
  .ts:not(:last-child)::after{display:none;}
  .ts-line{margin-bottom:0;}
  .ts-wire{display:block;}
}
</style>

<!-- MAIN -->
<div class="main">
<div class="tut">

<div class="tut-head">
  <div class="tut-logo">📱</div>
  <div class="tut-title">Install PerkUp on iPhone</div>
  <div class="tut-sub">3 simple steps — no App Store needed</div>
</div>

<div class="tut-steps">

  <%# ── STEP 1: Open in Safari & tap Share ── %>
  <div class="ts">
    <div class="ts-line">
      <div class="ts-num">1</div>
      <div class="ts-wire"></div>
    </div>
    <div class="ts-body">
      <div class="ts-title">Open PerkUp in Safari</div>
      <div class="ts-desc">
        Go to <strong>perkup.onrender.com</strong> in Safari, then tap the
        <span class="hl">⬆ Share button</span> at the bottom of the screen.
      </div>
      <div class="ts-img-wrap">
        <%= image_tag "tutorial/ios-step1-share.jpeg", alt: "Safari with Share button" %>
        <%# Red circle around the share button — adjust top/left/size to match your screenshot %>
        <div class="annotation" style="width:44px;height:44px;bottom:26px;left:calc(50% - 22px);"></div>
        <div class="arrow-label" style="bottom:82px;left:calc(50% - 50px);">Tap here ⬆</div>
      </div>
    </div>
  </div>

  <%# ── STEP 2: Tap "Add to Home Screen" ── %>
  <div class="ts">
    <div class="ts-line">
      <div class="ts-num">2</div>
      <div class="ts-wire"></div>
    </div>
    <div class="ts-body">
      <div class="ts-title">Tap "Add to Home Screen"</div>
      <div class="ts-desc">
        Scroll down in the menu and find
        <span class="hl">＋ Add to Home Screen</span>. Tap it.
      </div>
      <div class="ts-img-wrap">
        <%= image_tag "tutorial/ios-step2-menu.jpeg", alt: "Share menu - Add to Home Screen" %>
        <%# Red circle around "Add to Home Screen" row — adjust position to match %>
        <div class="annotation" style="width:90%;height:40px;border-radius:12px;bottom:21%;left:5%;"></div>
        <div class="arrow-label" style="bottom:15%;left:calc(50% - 40px);">Tap this ☝</div>
      </div>
    </div>
  </div>

  <%# ── STEP 3: Tap "Save" ── %>
  <div class="ts">
    <div class="ts-line">
      <div class="ts-num">3</div>
    </div>
    <div class="ts-body">
      <div class="ts-title">Tap "Save"</div>
      <div class="ts-desc">
        You'll see the PerkUp name and icon. Tap
        <span class="hl">Save</span> in the top right corner. That's it!
      </div>
      <div class="ts-img-wrap">
        <%= image_tag "tutorial/ios-step3-confirm.jpeg", alt: "Save confirmation" %>
        <%# Red circle around "Save" button — adjust position to match %>
        <div class="annotation" style="width:60px;height:34px;border-radius:10px;top:9%;right:0%;"></div>
        <div class="arrow-label" style="top:14%;right:20%;">Tap Save ☝</div>
      </div>
    </div>
  </div>

</div>
</div>
</div>