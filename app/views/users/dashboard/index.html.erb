<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=DM+Serif+Display&display=swap" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box;}
html,body{width:100%;min-height:100vh;background:#F5F0E8;color:#2D1B06;font-family:'DM Sans',system-ui,sans-serif;-webkit-font-smoothing:antialiased;}
body{display:flex;flex-direction:column;}

/* ── TOP NAV ── */
.topnav{
  height:56px;background:#FFFCF8;border-bottom:1px solid #F0E9DE;
  display:flex;align-items:center;justify-content:space-between;
  padding:0 20px;position:sticky;top:0;z-index:100;
}
.topnav-l{display:flex;align-items:center;gap:10px;}
.logo-m{width:28px;height:28px;border-radius:8px;background:#2D1B06;display:flex;align-items:center;justify-content:center;font-size:14px;color:#fff;}
.logo-t{font-weight:800;font-size:16px;color:#2D1B06;}
.topnav-r{display:flex;align-items:center;gap:12px;}
.nav-link{font-size:13px;font-weight:500;color:#8C7A65;text-decoration:none;padding:6px 12px;border-radius:8px;transition:all .15s;}
.nav-link:hover{color:#2D1B06;background:#F8F1E7;}
.nav-link.active{color:#2D1B06;font-weight:700;background:#F3ECE2;}
.nav-links-desktop{display:flex;align-items:center;gap:4px;}
.user-pill{
  display:flex;align-items:center;gap:8px;padding:4px 12px 4px 4px;
  border-radius:99px;background:#F3ECE2;cursor:pointer;transition:background .15s;
}
.user-pill:hover{background:#EAE0D2;}
.user-pill .av{width:28px;height:28px;border-radius:50%;background:linear-gradient(135deg,#A16207,#D4A017);display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;color:#fff;}
.user-pill .un{font-size:12px;font-weight:600;color:#2D1B06;}

/* ── MAIN ── */
.main{flex:1;max-width:680px;width:100%;margin:0 auto;padding:28px 20px 60px;}

/* Welcome */
.welcome{margin-bottom:28px;}
.welcome h1{font-family:'DM Serif Display',serif;font-size:26px;color:#2D1B06;margin-bottom:4px;}
.welcome p{font-size:14px;color:#8C7A65;}

/* My card */
.my-card{
  width:100%;border-radius:20px;padding:28px 24px;position:relative;overflow:hidden;
  background:linear-gradient(135deg,#1C1108,#2D1B06);color:#FFFCF8;
  box-shadow:0 10px 36px rgba(45,27,6,0.14);margin-bottom:24px;
}
.my-card::before{
  content:'';position:absolute;top:-40%;right:-20%;width:60%;height:120%;
  background:radial-gradient(circle,rgba(255,255,255,0.06),transparent 70%);pointer-events:none;
}
.my-card::after{
  content:'☕';position:absolute;bottom:10px;right:20px;font-size:52px;opacity:.04;pointer-events:none;
}
.mc-shop{font-size:10px;text-transform:uppercase;letter-spacing:2px;opacity:.45;position:relative;}
.mc-name{font-family:'DM Serif Display',serif;font-size:22px;margin-top:4px;position:relative;}
.mc-rule{font-size:12px;opacity:.45;margin-top:4px;position:relative;}
.mc-mid{display:flex;align-items:center;justify-content:space-between;margin-top:20px;position:relative;}
.mc-stamps{display:flex;flex-wrap:wrap;gap:6px;}
.mc-s{width:32px;height:32px;border-radius:9px;display:flex;align-items:center;justify-content:center;font-size:14px;}
.mc-s.on{background:rgba(212,160,23,0.2);border:1px solid rgba(245,203,92,0.25);}
.mc-s.off{background:rgba(255,255,255,0.04);border:1px dashed rgba(255,255,255,0.1);}
.mc-s.gift{background:linear-gradient(135deg,#A16207,#D4A017);border:none;box-shadow:0 0 12px rgba(212,160,23,0.3);}
.mc-pts{text-align:right;}
.mc-pts-label{font-size:9px;text-transform:uppercase;letter-spacing:2px;opacity:.4;}
.mc-pts-num{font-family:'DM Serif Display',serif;font-size:32px;color:#F5CB5C;margin-top:2px;}
.mc-progress{margin-top:18px;position:relative;}
.mc-bar{height:5px;background:rgba(255,255,255,0.08);border-radius:99px;overflow:hidden;}
.mc-fill{height:100%;background:linear-gradient(90deg,#A16207,#D4A017);border-radius:99px;}
.mc-bar-text{display:flex;justify-content:space-between;margin-top:6px;font-size:10px;opacity:.35;}

/* Sections */
.section{margin-bottom:24px;}
.section-h{display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;}
.section-h h2{font-size:16px;font-weight:700;color:#2D1B06;}
.section-h a{font-size:12px;color:#A16207;text-decoration:none;font-weight:600;}
.section-h a:hover{text-decoration:underline;}

/* Rewards */
.rew{
  display:flex;align-items:center;gap:14px;padding:14px 16px;
  background:#FFFCF8;border:1px solid #F0E9DE;border-radius:14px;
  margin-bottom:8px;transition:all .2s;
}
.rew:hover{border-color:#D4C4AC;box-shadow:0 2px 10px rgba(45,27,6,0.04);}
.rew-icon{width:40px;height:40px;border-radius:10px;background:#FEF3C7;display:flex;align-items:center;justify-content:center;font-size:18px;flex-shrink:0;}
.rew-info{flex:1;min-width:0;}
.rew-name{font-size:13px;font-weight:700;color:#2D1B06;}
.rew-desc{font-size:11px;color:#8C7A65;margin-top:1px;}
.rew-badge{padding:5px 12px;border-radius:8px;font-size:11px;font-weight:700;white-space:nowrap;}
.rew-badge.ready{background:#D1FAE5;color:#166534;}
.rew-badge.lock{background:#F3ECE2;color:#8C7A65;}

/* Activity */
.act{
  display:flex;align-items:center;gap:12px;padding:12px 16px;
  background:#FFFCF8;border:1px solid #F0E9DE;border-radius:12px;
  margin-bottom:6px;
}
.act-dot{width:8px;height:8px;border-radius:50%;flex-shrink:0;}
.act-dot.earn{background:#16A34A;}
.act-dot.use{background:#A16207;}
.act-body{flex:1;min-width:0;}
.act-title{font-size:13px;font-weight:600;color:#2D1B06;}
.act-time{font-size:11px;color:#B8A898;}
.act-val{font-size:13px;font-weight:700;white-space:nowrap;}
.act-val.pos{color:#16A34A;}
.act-val.neg{color:#A16207;}

/* ── MOBILE NAV ── */
.mob-nav{
  display:none;position:fixed;bottom:0;left:0;right:0;z-index:100;
  background:#FFFCF8;border-top:1px solid #F0E9DE;
  padding:6px 0 calc(6px + env(safe-area-inset-bottom));
}
.mob-nav-inner{display:flex;justify-content:space-around;}
.mn-item{
  display:flex;flex-direction:column;align-items:center;gap:2px;
  padding:6px 12px;font-size:10px;font-weight:600;color:#B8A898;
  text-decoration:none;transition:color .15s;
}
.mn-item {font-size:15px;}
.mn-item.active{color:#A16207;}

@media(max-width:600px){
  .nav-links-desktop{display:none;}
  .mob-nav{display:block;}
  .main{padding-bottom:100px;}
  .welcome h1{font-size:22px;}
}
.rew-link{text-decoration:none;display:block;}

/* Modal overlay */
.cm-overlay{
  display:none;
  position:fixed;inset:0;z-index:9999;
  background:rgba(0,0,0,0.4);
  align-items:center;justify-content:center;
  padding:24px;
}
.cm-overlay.show{display:flex;}

/* Modal box */
.cm-modal{
  background:#FFFCF8;
  border-radius:24px;
  padding:36px 32px;
  text-align:center;
  max-width:380px;
  width:100%;
  position:relative;
  box-shadow:0 20px 60px rgba(45,27,6,0.15);
  animation:cm-in .3s ease;
}
@keyframes cm-in{
  from{opacity:0;transform:scale(0.95) translateY(10px);}
  to{opacity:1;transform:scale(1) translateY(0);}
}

/* Close button */
.cm-close{
  position:absolute;top:14px;right:14px;
  width:32px;height:32px;border-radius:10px;
  border:none;background:#F3ECE2;
  cursor:pointer;font-size:16px;
  display:flex;align-items:center;justify-content:center;
  color:#8C7A65;transition:all .15s;
}
.cm-close:hover{background:#EAE0D2;color:#2D1B06;}

/* Icon */
.cm-icon{
  width:56px;height:56px;border-radius:16px;
  background:#FEF3C7;
  display:inline-flex;align-items:center;justify-content:center;
  font-size:28px;margin-bottom:16px;
}

/* Title */
.cm-title{
  font-family:'DM Serif Display',serif;
  font-size:22px;color:#2D1B06;margin-bottom:4px;
}

/* Expires */
.cm-expires{
  font-size:13px;color:#8C7A65;margin-bottom:24px;
}

/* QR box */
.cm-qr-box{
  display:inline-flex;
  padding:20px;
  background:#fff;
  border-radius:16px;
  border:2px solid #F0E9DE;
  margin-bottom:16px;
  min-width:220px;min-height:220px;
  align-items:center;justify-content:center;
  position:relative;
}

.cm-qr-img{
  width:180px;height:180px;
  transition:opacity .3s;
}

.cm-qr-loading{
  position:absolute;
  font-size:12px;color:#B8A898;
}
.cm-qr-img[src=""]+.cm-qr-loading,
.cm-qr-img[style*="opacity: 0"]+.cm-qr-loading{display:block;}
.cm-qr-img[style*="opacity: 1"]+.cm-qr-loading{display:none;}

/* Code */
.cm-code{
  font-family:'DM Sans',monospace;
  font-size:14px;font-weight:700;
  color:#5C4A35;
  background:#F8F4ED;
  display:inline-block;
  padding:6px 16px;
  border-radius:8px;
  letter-spacing:2px;
  margin-bottom:16px;
}

/* Hint */
.cm-hint{
  font-size:12px;color:#B8A898;
}

@media(max-width:480px){
  .cm-modal{padding:28px 20px;border-radius:20px;}
  .cm-qr-img{width:160px;height:160px;}
}
</style>

<!-- MAIN -->
<div class="main">

  <!-- Welcome -->
  <% if @user_card.present? %>
    <div class="welcome">
      <h1>Hey <%= current_user.full_name %></h1>
      <% if @empty_stamps > 0 %>
        <p><%= @empty_stamps %> stamps away from a free coffee!</p>
      <% else %>
        <p>Next <%= @card.how_many %> coffee is free!</p>
      <% end %>
    </div>

    <!-- My Card -->
    <div class="my-card" style="background: <%= color_gradient(@card.color) %>">
      <div class="mc-shop"><%= @card.name %></div>
      <div class="mc-name"><%= current_user.full_name %></div>
      <div class="mc-rule">Buy <%= @card.reward_rule %> coffees → next <%= @card.how_many %> are free</div>
      <div class="mc-mid">
        <div class="mc-stamps">
          <% @how_many_stamps_on_user_card.times do%>
            <div class="mc-s on">☕</div>
          <%end%>
          <% @empty_stamps.times do%>
            <div class="mc-s off"></div>
          <%end%>
          <% @card.how_many.times do%>
            <div class="mc-s gift">🎁</div>
          <%end%>
        </div>
        <div class="mc-pts">
          <div class="mc-pts-label">Points</div>
          <div class="mc-pts-num"><%= @user_card.points %></div>
        </div>
      </div>
      <div class="mc-progress">
        <div class="mc-bar"><div class="mc-fill" style="width:<%= stamp_progress_width(@how_many_stamps_on_user_card, @card.reward_rule) %>%"></div></div>
        <div class="mc-bar-text"><span><%= @how_many_stamps_on_user_card %> of <%= @card.reward_rule %> stamps</span><span><%= @empty_stamps %> more to go</span></div>
      </div>
    </div>

    <!-- Coupons -->
    <%= render "users/shared/coupon_modal" %>

    <!-- Recent -->
    <div class="section">
      <div class="section-h">
        <h2>Recent Activity</h2>
        <%= link_to 'View all', activities_coupons_path %>
      </div>
      <% if @last_4_stamps.any? %>
        <% @last_4_stamps.each do |stamp| %>
          <div class="act">
            <div class="act-dot earn"></div>
            <div class="act-body"><div class="act-title">Coffee</div><div class="act-time"><%= friendly_time(stamp.created_at) %></div></div>
            <div class="act-val pos">+1</div>
          </div>
        <% end %>
      <% else %>
        <div class="act">
          <div class="act-dot use"></div>
          <div class="act-body"><div class="act-title">You have no activity yet!</div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="welcome">
      <h1>Hey <%= current_user.full_name %> ☀️</h1>
    </div>
    <br><br><br><br><br>
    <h1>you have no cards</h1>
  <% end %>
</div>
